*.tmp
*.bak

# ВАЖНО: НЕ игнорируем Assets/, ProjectSettings/, Packages/
# и НИКОГДА не добавляйте *.meta в .gitignore —
# без .meta файлов Unity потеряет все связи в сценах и префабах!
